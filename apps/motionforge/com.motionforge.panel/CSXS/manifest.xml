<?xml version="1.0" encoding="UTF-8"?>
<!-- Ref: https://github.com/Adobe-CEP/CEP-Resources/blob/master/CEP_11.x/Documentation/CEP%2011.1%20HTML%20Extension%20Cookbook.md -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.motionforge.panel" ExtensionBundleVersion="1.0.0" ExtensionBundleName="MotionForge"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList><Extension Id="com.motionforge.panel.main" Version="1.0.0"/></ExtensionList>
  <ExecutionEnvironment>
    <HostList><Host Name="AEFT" Version="[22.0,99.9]"/></HostList>
    <LocaleList><Locale Code="All"/></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="11.0"/></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.motionforge.panel.main">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>MotionForge</Menu>
          <Geometry>
            <Size><Height>640</Height><Width>360</Width></Size>
            <MinSize><Height>420</Height><Width>300</Width></MinSize>
            <MaxSize><Height>2000</Height><Width>900</Width></MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/icon-dark.png</Icon>
            <Icon Type="RollOver">./icons/icon-dark.png</Icon>
            <Icon Type="DarkNormal">./icons/icon-dark.png</Icon>
            <Icon Type="DarkRollOver">./icons/icon-dark.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
