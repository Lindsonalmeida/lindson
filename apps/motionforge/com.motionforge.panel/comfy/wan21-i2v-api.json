{
  "_motionforge": "Wan 2.1 I2V 480p (exemplo oficial do ComfyUI). Confira se os nomes dos arquivos de modelo batem com os da sua pasta ComfyUI/models. Marcadores: {{image}} {{prompt}} {{negative}} {{seed}} {{width}} {{height}} {{frames}}.",
  "37": { "class_type": "UNETLoader", "inputs": { "unet_name": "wan2.1_i2v_480p_14B_fp8_e4m3fn.safetensors", "weight_dtype": "default" } },
  "38": { "class_type": "CLIPLoader", "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default" } },
  "39": { "class_type": "VAELoader", "inputs": { "vae_name": "wan_2.1_vae.safetensors" } },
  "49": { "class_type": "CLIPVisionLoader", "inputs": { "clip_name": "clip_vision_h.safetensors" } },
  "52": { "class_type": "LoadImage", "inputs": { "image": "{{image}}" } },
  "51": { "class_type": "CLIPVisionEncode", "inputs": { "clip_vision": ["49", 0], "image": ["52", 0], "crop": "none" } },
  "6": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{prompt}}", "clip": ["38", 0] } },
  "7": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{negative}}", "clip": ["38", 0] } },
  "50": { "class_type": "WanImageToVideo", "inputs": { "positive": ["6", 0], "negative": ["7", 0], "vae": ["39", 0], "clip_vision_output": ["51", 0], "start_image": ["52", 0], "width": "{{width}}", "height": "{{height}}", "length": "{{frames}}", "batch_size": 1 } },
  "54": { "class_type": "ModelSamplingSD3", "inputs": { "model": ["37", 0], "shift": 8 } },
  "3": { "class_type": "KSampler", "inputs": { "model": ["54", 0], "positive": ["50", 0], "negative": ["50", 1], "latent_image": ["50", 2], "seed": "{{seed}}", "steps": 20, "cfg": 6, "sampler_name": "uni_pc", "scheduler": "simple", "denoise": 1 } },
  "8": { "class_type": "VAEDecode", "inputs": { "samples": ["3", 0], "vae": ["39", 0] } },
  "60": { "class_type": "SaveImage", "inputs": { "images": ["8", 0], "filename_prefix": "MotionForge/wan" } }
}
